{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug the app (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    },
    {
      "name": "Debug exercise tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run ex -- ${input:exercise} --once"
    }
  ],
  "inputs": [
    { "id": "exercise", "type": "promptString", "description": "Exercise, e.g. m00/03 or m05", "default": "m00/03" }
  ]
}
